{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Greptime Dashboard",
  "version": "0.8.23",
  "identifier": "com.greptime",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5177",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Greptime Dashboard",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "signingIdentity": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyODI1Q0FBRUVCMDc0OTgKUldTWWRMRHVxbHlDMGxiUTIvdUhnK3RyS0FneHdySjdHRWZaZWRUSG4zRHp3SndwZUZ0T2JHRVoK",
      "endpoints": ["https://github.com/midy177/greptimedb-dashboard/releases/latest/download/latest.json"]
    }
  }
}
